# Public project settings required by the dedicated game server.
PROJECT_UNKNOWN_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PROJECT_UNKNOWN_SUPABASE_PUBLIC_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY

# Keep this high-entropy value private. Set the same value as the Supabase
# Edge Function secret GAME_SERVER_SHARED_SECRET. Never include it in the APK.
PROJECT_UNKNOWN_GAME_SERVER_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
